{
  "name": "haven",
  "private": true,
  "version": "0.1.0",
  "description": "Haven — chat for people who can't be understood. Accessible, multilingual care chat powered by Awaaz, built on the Nexconn Chat SDK.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "test": "node --test server/api.test.js test/match.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/baloo-paaji-2": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/mukta-mahee": "^5.3.0",
    "@nexconn/chat": "26.2.1",
    "@nexconn/engine": "26.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
