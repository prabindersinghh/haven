# Nexconn credentials (Console -> Key Management). Server-side only; never ship the secret to the browser.
# Leave both empty to run Haven in in-browser demo mode.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center of your app: sg | na | sa
NEXCONN_REGION=sg
# Group channel id used as the volunteer dispatch room
HAVEN_DISPATCH_CHANNEL_ID=havendispatch
# Production server port (npm start)
PORT=8787
